{
  "meta": {
    "title": "초기 애착 성향 설문",
    "scale": "Likert 1-5",
    "dimensions": ["회피", "불안"],
    "reverse_key": "reverse"
  },
  "items": [
    { "id": 1, "text": "나는 내 속마음을 연인에게 보여주지 않으려 한다.", "dimension": "회피", "reverse": false },
    { "id": 2, "text": "나는 버림받을까 봐 걱정한다.", "dimension": "불안", "reverse": false },
    { "id": 3, "text": "연인이 가까워지려 할 때, 나는 밀어내려는 경향이 있다.", "dimension": "회피", "reverse": false },
    { "id": 4, "text": "나는 내 연애 관계에 대해 많은 걱정을 한다.", "dimension": "불안", "reverse": false },
    { "id": 5, "text": "연인이 너무 가까이 다가오면 불편하다.", "dimension": "회피", "reverse": false },
    { "id": 6, "text": "연인이 내가 그를 생각하는 만큼 나를 생각하지 않을까 걱정한다.", "dimension": "불안", "reverse": false },
    { "id": 7, "text": "연인에게 솔직하게 마음을 여는 것이 편하지 않다.", "dimension": "회피", "reverse": false },
    { "id": 8, "text": "연인을 잃을까 봐 많이 걱정한다.", "dimension": "불안", "reverse": false },
    { "id": 9, "text": "나는 파트너에게 다가가고 싶지만, 다시 물러나곤 한다.", "dimension": "회피", "reverse": false },
    { "id": 10, "text": "연인이 나를 생각하는 정도가 내가 연인을 생각하는 정도만큼이기를 바란다.", "dimension": "불안", "reverse": false },
    { "id": 11, "text": "연인이 너무 가까이 다가오면 불안해진다.", "dimension": "회피", "reverse": false },
    { "id": 12, "text": "나는 연인과 완전히 하나 되고 싶어 하지만, 이것이 그를 겁먹게 한다.", "dimension": "불안", "reverse": false },
    { "id": 13, "text": "나는 내 사적인 생각과 감정을 연인과 나누는 것이 편하다.", "dimension": "회피", "reverse": true },
    { "id": 14, "text": "나는 혼자일까 봐 걱정한다.", "dimension": "불안", "reverse": false },
    { "id": 15, "text": "연인과 너무 가까워지는 것을 피하려 한다.", "dimension": "회피", "reverse": false },
    { "id": 16, "text": "내가 너무 가까이 다가가려는 욕구 때문에 상대가 두려워한다.", "dimension": "불안", "reverse": false },
    { "id": 17, "text": "연인과 가까워지는 것이 비교적 쉽다.", "dimension": "회피", "reverse": true },
    { "id": 18, "text": "나는 연인에게 내가 사랑받고 있다는 확신이 필요하다.", "dimension": "불안", "reverse": false },
    { "id": 19, "text": "연인에게 의지하는 것이 어렵다.", "dimension": "회피", "reverse": false },
    { "id": 20, "text": "나는 종종 연인에게 더 많은 감정과 헌신을 요구한다고 느낀다.", "dimension": "불안", "reverse": false },
    { "id": 21, "text": "연인과 너무 가까워지지 않으려 한다.", "dimension": "회피", "reverse": false },
    { "id": 22, "text": "나는 버림받는 것에 대해 자주 걱정하지 않는다.", "dimension": "불안", "reverse": true },
    { "id": 23, "text": "나는 연인에게 거의 모든 것을 말한다.", "dimension": "회피", "reverse": true },
    { "id": 24, "text": "연인이 나에게 관심을 보이지 않으면 화가 나거나 속상하다.", "dimension": "불안", "reverse": false },
    { "id": 25, "text": "나는 내 고민과 걱정을 연인과 나누는 편이다.", "dimension": "회피", "reverse": true },
    { "id": 26, "text": "나는 연인이 내가 원하는 만큼 가까워지지 않는다고 느낀다.", "dimension": "불안", "reverse": false },
    { "id": 27, "text": "연인에게 의지하는 것이 편하다.", "dimension": "회피", "reverse": true },
    { "id": 28, "text": "나는 연인이 곁에 없을 때 불안하고 불안정하다.", "dimension": "불안", "reverse": false },
    { "id": 29, "text": "연인에게 위로나 조언을 구하는 것이 불편하지 않다.", "dimension": "회피", "reverse": true },
    { "id": 30, "text": "나는 연인이 내가 원하는 만큼 곁에 있지 않을 때 좌절감을 느낀다.", "dimension": "불안", "reverse": false },
    { "id": 31, "text": "힘들 때 연인에게 기대는 것이 도움이 된다.", "dimension": "회피", "reverse": true },
    { "id": 32, "text": "연인이 필요할 때 곁에 없으면 짜증이 난다.", "dimension": "불안", "reverse": false },
    { "id": 33, "text": "나는 위로나 확신을 포함해 많은 부분을 연인에게 의존한다.", "dimension": "회피", "reverse": true },
    { "id": 34, "text": "연인이 나를 못마땅해할 때 나는 자신에 대해 매우 기분이 나빠진다.", "dimension": "불안", "reverse": false },
    { "id": 35, "text": "나는 연인에게 너무 많이 의존하지 않으려 한다.", "dimension": "회피", "reverse": false },
    { "id": 36, "text": "연인이 나와 떨어져 있는 시간을 보내면 불만을 느낀다.", "dimension": "불안", "reverse": false }
  ]
}
